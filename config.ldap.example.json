{
  "server": {
    "host": "127.0.0.1",
    "port": 9002,
    "tls_enabled": true,
    "tls_cert_file": "/path/to/cert.pem",
    "tls_key_file": "/path/to/key.pem",
    "enable_http2": true
  },
  "entry_point": "https://api.apiproxy.app",
  "api_key": "apx_live_xxxxxxxxxxxxxxxxxxxxx",
  "cache": {
    "backend": "postgres",
    "connection_string": "postgres://user:pass@localhost:5432/apiproxy_cache",
    "ttl": 86400,
    "memory_cache_enabled": true,
    "memory_cache_size": 1000,
    "max_open_conns": 25,
    "max_idle_conns": 5,
    "cleanup_interval": 3600
  },
  "security": {
    "rate_limit_enabled": true,
    "rate_limit_per_ip": 60,
    "rate_limit_per_key": 300,
    "rate_limit_burst": 10,
    "ssrf_protection_enabled": true,
    "allowed_upstream_hosts": [
      "api.apiproxy.app",
      "infoblox.company.com",
      "bluecat.company.com"
    ],
    "block_private_ips": true
  },
  "client": {
    "request_timeout": 30,
    "circuit_breaker_enabled": true,
    "circuit_breaker_threshold": 5,
    "deduplication_enabled": true
  },
  "ldap": {
    "enabled": true,
    "server": "ldap.company.com:636",
    "use_tls": true,
    "use_ssl": false,
    "insecure": false,
    "bind_dn": "cn=apiproxy-service,ou=services,dc=company,dc=com",
    "bind_password": "service_account_password",
    "base_dn": "ou=users,dc=company,dc=com",
    "user_filter": "(uid=%s)",
    "require_group": "cn=api-users,ou=groups,dc=company,dc=com",
    "pool_size": 10,
    "conn_max_lifetime": 600,
    "conn_timeout": 10,
    "cache_enabled": true,
    "cache_ttl": 300
  },
  "plugins": {
    "enabled": true,
    "plugins": [
      {
        "name": "infoblox",
        "type": "go",
        "path": "./examples/plugins/go/infoblox/infoblox.so",
        "enabled": true,
        "config": {
          "cache_network_objects": 3600,
          "cache_dns_records": 300,
          "cache_dhcp_objects": 120
        }
      },
      {
        "name": "bluecat",
        "type": "go",
        "path": "./examples/plugins/go/bluecat/bluecat.so",
        "enabled": true,
        "config": {
          "cache_config_objects": 3600,
          "cache_dns_records": 300,
          "cache_dhcp_objects": 120
        }
      },
      {
        "name": "logger",
        "type": "go",
        "path": "./examples/plugins/go/logger/logger.so",
        "enabled": false,
        "config": {
          "log_level": "info"
        }
      }
    ]
  }
}
